{
  "manifest_version": 3,
  "name": "EngagED Thread Builder",
  "version": "0.1.0",
  "description": "Gera threads padronizadas para Slack a partir do contexto da página.",
  "permissions": ["storage","activeTab","scripting"],
  "action": {
    "default_title": "EngagED Thread Builder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
